{{!
    Stable Modern Course Blocks 
    - Compatible with Bootstrap 4 (Academi theme)
    - Fixed image aspect ratios
    - Removed broken B5 helpers
}}

{{#availablecourses}}
<div class="available-courses py-5" id="available-courses">
    <div class="container">
        <div class="row">
            {{#courses}}
            <div class="col-12 col-md-6 col-lg-4 mb-4">
                <div class="card h-100 border-0 shadow-sm custom-course-card">
                    {{! Фиксированное соотношение сторон через CSS }}
                    <div class="card-img-container">
                        <a href="{{link}}">
                            <img src="{{imgurl}}" alt="{{name}}" class="img-fluid w-100 shadow-sm" loading="lazy">
                        </a>
                    </div>
                    
                    <div class="card-body p-3 d-flex flex-column">
                        <h5 class="card-title fw-bold mb-2">
                            <a href="{{link}}" class="text-dark text-decoration-none small">{{name}}</a>
                        </h5>
                        
                        {{#summary}}
                        <div class="card-text text-muted small mb-0 flex-grow-1 line-clamp-3">
                            {{#shortentext}}120, {{{summary}}}{{/shortentext}}
                        </div>
                        {{/summary}}
                        
                        {{! Ссылка-заглушка для всей карточки (Stretched Link hack) }}
                        <a href="{{link}}" class="stretched-link"></a>
                    </div>
                </div>
            </div>
            {{/courses}}
        </div>
    </div>
</div>
{{/availablecourses}}

{{#promotedcourse}}
    {{#blockisempty}}
    <div class="promoted-courses py-5 bg-light" id="promoted-courses">
        <div class="container text-center">
            {{#promotedcontent}}
            <div class="mb-5">
                <h2 class="h4 font-weight-bold">{{promotedtitle}}</h2>
                {{#promotedcoursedesc}}<p class="text-muted">{{promotedcoursedesc}}</p>{{/promotedcoursedesc}}
            </div>
            {{/promotedcontent}}

            <div class="row justify-content-center">
                {{#courses}}
                {{#.}}
                <div class="col-6 col-sm-4 col-md-3 col-lg-2 mb-4 d-flex justify-content-center">
                    <a href="{{courseurl}}" class="text-decoration-none promoted-item">
                        <div class="icon-circle shadow-sm mx-auto mb-2">
                            <img src="{{imgurl}}" alt="{{coursename}}" class="rounded-circle w-100 h-100" style="object-fit: cover;">
                        </div>
                        <span class="d-block small font-weight-bold text-dark text-truncate px-2">{{coursename}}</span>
                    </a>
                </div>
                {{/.}}
                {{/courses}}
            </div>
        </div>
    </div>
    {{/blockisempty}}
{{/promotedcourse}}

<style>
/* Совместимость и магия CSS */

.custom-course-card {
    transition: all 0.3s ease;
    position: relative;
    border-radius: 12px !important;
    overflow: hidden;
}

.custom-course-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 5px 9px rgba(0,0,0,0.1) !important;
}

/* Фиксация картинки 16:9 без Bootstrap 5 Helper */
.card-img-container {
    position: relative;
    width: 100%;
    padding-top: 56.25%; /* 16:9 Aspect Ratio */
    overflow: hidden;
}

.card-img-container img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* Обрезка текста до 3 строк */
.line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-height: 4.5em; /* Fallback */
}

/* Стили для промо-блоков */
.icon-circle {
    width: 80px;
    height: 80px;
    background: #fff;
    border-radius: 50%;
    padding: 3px;
    transition: transform 0.2s ease;
}

.promoted-item:hover .icon-circle {
    transform: scale(1.05);
    box-shadow: 0 0 0 1px #007bff !important;
}

/* Stretched link fix для старых браузеров */
.stretched-link::after {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    content: "";
}
</style>