{{!
    Adaptive Modern Course Blocks 
    - Full background image with text overlay
    - Compatible with Bootstrap 4 (Academi theme)
    - Auto-responsive grid that fills available space
}}

{{#availablecourses}}
<div class="available-courses py-5" id="available-courses">
    <div class="container">
        <div class="adaptive-course-grid">
            {{#courses}}
            <div class="course-grid-item p-2">
                <div class="card h-100 border-0 shadow-sm custom-course-card rounded-4 overflow-hidden position-relative">
                    {{! Background Image Layer }}
                    <div class="card-img-wrapper position-absolute top-0 start-0 w-100 h-100">
                        <img src="{{imgurl}}" alt="{{name}}" class="img-fluid w-100 h-100" style="object-fit: cover;" loading="lazy">
                        {{! Dark overlay for better contrast base }}
                        <div class="img-overlay"></div>
                    </div>
                    
                    {{! Content Body - Pushed to bottom }}
                    <div class="card-body p-0 d-flex flex-column justify-content-end position-relative" style="z-index: 2;">
                        {{! Glassmorphism Footer }}
                        <div class="glass-footer w-100 p-3">
                            <h5 class="card-title fw-bold text-white mb-2" style="font-size: 1.1rem; line-height: 1.3;">
                                <a href="{{link}}" class="text-white text-decoration-none title-clamp">{{name}}</a>
                            </h5>
                            
                            {{#summary}}
                            <div class="card-text text-white-50 small mb-0">
                                <div class="text-truncate-2-lines">
                                    {{#shortentext}}100, {{{summary}}}{{/shortentext}}
                                </div>
                            </div>
                            {{/summary}}
                        </div>
                        
                        {{! Full card link }}
                        <a href="{{link}}" class="stretched-link"></a>
                    </div>
                </div>
            </div>
            {{/courses}}
        </div>
    </div>
</div>
{{/availablecourses}}

{{#promotedcourse}}
    {{#blockisempty}}
    <div class="promoted-courses py-5 bg-light" id="promoted-courses">
        <div class="container text-center">
            {{#promotedcontent}}
            <div class="mb-5">
                <h2 class="h4 font-weight-bold">{{promotedtitle}}</h2>
                {{#promotedcoursedesc}}
                <p class="text-muted mb-0">{{promotedcoursedesc}}</p>
                {{/promotedcoursedesc}}
            </div>
            {{/promotedcontent}}

            <div class="row justify-content-center g-3">
                {{#courses}}
                {{#.}}
                <div class="col-6 col-sm-4 col-md-3 col-lg-2 mb-4">
                    <a href="{{courseurl}}" class="text-decoration-none promoted-item d-block">
                        <div class="position-relative mx-auto mb-2" style="width: 80px; height: 80px;">
                            <div class="position-absolute top-0 start-0 w-100 h-100 rounded-circle bg-white p-1 shadow-sm"></div>
                            <img src="{{imgurl}}" alt="{{coursename}}" class="position-absolute top-0 start-0 w-100 h-100 rounded-circle" style="object-fit: cover; z-index: 2;">
                        </div>
                        <span class="d-block small font-weight-bold text-dark text-truncate px-1">{{coursename}}</span>
                    </a>
                </div>
                {{/.}}
                {{/courses}}
            </div>
        </div>
    </div>
    {{/blockisempty}}
{{/promotedcourse}}

<style>
/* Adaptive Grid System */
.adaptive-course-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
    width: 100%;
}

.custom-course-card {
    aspect-ratio: 16/10;
    transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.4s ease;
    background: #2a2a2a;
}

/* Hover Effects */
.custom-course-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.25) !important;
}

/* Image Handling */
.card-img-wrapper img {
    transition: transform 0.8s ease;
}

.custom-course-card:hover .card-img-wrapper img {
    transform: scale(1.1);
}

.img-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 60%, rgba(0,0,0,0.6) 100%);
    pointer-events: none;
}

/* Glassmorphism Footer */
.glass-footer {
    background: rgba(15, 15, 15, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    transition: background 0.3s ease;
}

.custom-course-card:hover .glass-footer {
    background: rgba(10, 10, 10, 0.9);
}

/* Typography */
.title-clamp {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.text-truncate-2-lines {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.4;
    opacity: 0.8;
}

/* Stretched link fix */
.stretched-link {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
}
</style>