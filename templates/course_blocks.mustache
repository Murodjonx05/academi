{{!
    Stable Modern Course Blocks 
    - Full background image with text overlay
    - Compatible with Bootstrap 4 (Academi theme)
    - Enhanced with modern Bootstrap 4 classes
}}

{{#availablecourses}}
<div class="available-courses py-5" id="available-courses">
    <div class="container">
        <div class="row">
            {{#courses}}
            <div class="col-12 col-md-6 col-lg-4 mb-4 p-0">
                <div class="card h-100 border-0 shadow-sm custom-course-card rounded-3 overflow-hidden position-relative" style="aspect-ratio: 16/9;">
                    {{! Full background image }}
                    <div class="position-absolute top-0 start-0 w-100 h-100">
                        <img src="{{imgurl}}" alt="{{name}}" class="img-fluid w-100 h-100" style="object-fit: cover;" loading="lazy">
                    </div>
                    
                    {{! Overlay gradient for better text readability }}
                    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.1) 20%, rgba(0,0,0,0.7) 100%);"></div>
                    
                    {{! Blur effect only on bottom part where text is located }}
                    <div class="position-absolute bottom-0 start-0 w-100" style="height: 60px; backdrop-filter: blur(3px); background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0.1) 100%);"></div>
                    
                    <div class="card-body p-4 d-flex flex-column justify-content-end position-relative" style="min-height: 0;">
                        <h5 class="card-title fw-bold text-white mb-2 text-truncate">
                            <a href="{{link}}" class="text-white text-decoration-none small">{{name}}</a>
                        </h5>
                        
                        {{#summary}}
                        <div class="card-text text-white-50 small mb-0">
                            <div class="text-truncate-3-lines">
                                {{#shortentext}}120, {{{summary}}}{{/shortentext}}
                            </div>
                        </div>
                        {{/summary}}
                        
                        {{! Ссылка-заглушка для всей карточки }}
                        <a href="{{link}}" class="stretched-link position-absolute top-0 start-0 w-100 h-100" style="z-index: 1;"></a>
                    </div>
                </div>
            </div>
            {{/courses}}
        </div>
    </div>
</div>
{{/availablecourses}}

{{#promotedcourse}}
    {{#blockisempty}}
    <div class="promoted-courses py-5 bg-light" id="promoted-courses">
        <div class="container text-center">
            {{#promotedcontent}}
            <div class="mb-5">
                <h2 class="h4 font-weight-bold">{{promotedtitle}}</h2>
                {{#promotedcoursedesc}}
                <p class="text-muted mb-0">{{promotedcoursedesc}}</p>
                {{/promotedcoursedesc}}
            </div>
            {{/promotedcontent}}

            <div class="row justify-content-center g-3">
                {{#courses}}
                {{#.}}
                <div class="col-6 col-sm-4 col-md-3 col-lg-2 mb-4">
                    <a href="{{courseurl}}" class="text-decoration-none promoted-item d-block">
                        <div class="position-relative mx-auto mb-2" style="width: 80px; height: 80px;">
                            <div class="position-absolute top-0 start-0 w-100 h-100 rounded-circle bg-white p-1 shadow-sm"></div>
                            <img src="{{imgurl}}" alt="{{coursename}}" class="position-absolute top-0 start-0 w-100 h-100 rounded-circle" style="object-fit: cover; z-index: 2;">
                        </div>
                        <span class="d-block small font-weight-bold text-dark text-truncate px-1">{{coursename}}</span>
                    </a>
                </div>
                {{/.}}
                {{/courses}}
            </div>
        </div>
    </div>
    {{/blockisempty}}
{{/promotedcourse}}

<style>
/* Совместимость и магия CSS */

.custom-course-card {
    transition: all 0.3s ease;
    position: relative;
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075) !important;
    background: transparent !important;
    border-radius: 32px !important;
}

.custom-course-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
}

/* Обрезка текста до 3 строк */
.text-truncate-3-lines {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-height: 4.5em; /* Fallback */
}

/* Aspect-ratio 16:9 для карточек курсов */
.custom-course-card {
    aspect-ratio: 16/9;
    min-height: 180px;
}

/* Стили для промо-блоков */
.promoted-item {
    transition: all 0.2s ease;
}

.promoted-item:hover {
    transform: translateY(-2px);
}

.promoted-item:hover .rounded-circle {
    box-shadow: 0 0 0 2px #007bff !important;
}

/* Stretched link fix */
.stretched-link {
    text-decoration: none;
}

/* Responsive adjustments */
@media (max-width: 768px) {
    .custom-course-card {
        margin-bottom: 1rem;
        aspect-ratio: 16/9;
    }
    
    .blur-overlay {
        height: 50px !important;
    }
}

@media (max-width: 576px) {
    .blur-overlay {
        height: 45px !important;
    }
    
    .col-12.col-md-6.col-lg-4.mb-4 {
        margin-bottom: 1.5rem !important;
    }
}

/* Hover effects for better UX */
.card-title a:hover {
    color: rgba(255, 255, 255, 0.9) !important;
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
}

/* Focus states for accessibility */
.custom-course-card a:focus,
.promoted-item:focus {
    outline: 2px solid #007bff;
    outline-offset: 2px;
    border-radius: 8px;
}

/* Smooth transitions */
img {
    transition: transform 0.3s ease;
}

.custom-course-card:hover img {
    transform: scale(1.05);
}

/* Text shadow for better readability */
.card-title,
.card-text {
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
}

/* Gradient border effect */
.custom-course-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.custom-course-card:hover::before {
    opacity: 1;
}

/* Remove global backdrop-filter to avoid performance issues */
.card-body {
    background: transparent;
}

/* Glow effect on hover */
.custom-course-card:hover::after {
    content: '';
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    border-radius: 24px!important;
    z-index: -1;
    filter: blur(4px);
    opacity: 0.3;
    transition: opacity 0.3s ease;
}

.custom-course-card:hover::after {
    opacity: 0.5;
}
</style>