  }

  .navbar-toggler.aabtn:hover {
    background-color: #f7fafc !important;
  }

  /* CENTER: критически важно — не мешать moremenu */
  #header .primary-navigation {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-width: 0;
    margin: 0 1rem; /* уменьшено с 1.5rem */
