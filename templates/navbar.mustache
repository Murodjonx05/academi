<nav id="header" class="{{^themestyleheader }} moodle-based-header {{/themestyleheader }} fixed-top navbar navbar-light bg-faded navbar-static-top navbar-expand moodle-has-zindex shadow-sm" aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="container-fluid navbar-nav">
            {{^themestyleheader}}
                <button class="navbar-toggler aabtn d-block d-md-none px-1 my-1 border-0 bg-white rounded" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-primary">
                    <span class="navbar-toggler-icon"></span>
                    <span class="sr-only">{{#str}}sidepanel, core{{/str}}</span>
                </button>
                <a href="{{{ config.wwwroot }}}/?redirect=0" class="navbar-brand {{# logourl }}has-logo{{/ logourl }} {{^ logourl }} hidden-sm-down {{/ logourl }} d-flex align-items-center">
                    {{#showlogo}}
                        {{# logourl }}
                            <span class="logo me-2">
                                <img src="{{logourl}}" alt="{{sitename}}" class="img-fluid ">
                            </span>
                        {{/ logourl }}
                        {{^ logourl }}
                            <span class="site-name hidden-sm-down fw-bold">{{{ sitename }}}</span>
                        {{/ logourl }}
                    {{/showlogo}}
                    {{#showsitename}}
                        <span class="nav-site-name text-truncate">{{{sitename}}}</span>
                    {{/showsitename}}
                </a>
            {{/themestyleheader}}

            {{#themestyleheader}}
                <nav class="nav navbar-nav hidden-md-down address-head flex-wrap gap-3">
                    {{# phoneno}}
                        <span class="d-flex align-items-center"><i class="fa fa-phone me-2"></i>{{#str}}callus, theme_academi{{/str}} : {{ phoneno }}</span>
                    {{/ phoneno}}
                    {{# emailid}}
                        <span class="d-flex align-items-center"><i class="fa fa-envelope-o me-2"></i>{{#str}}email, theme_academi{{/str}} : <a href="mailto:{{emailid}}" class="text-white text-decoration-none">{{ emailid }}</a></span>
                    {{/ emailid}}
                </nav>
            {{/themestyleheader}}

        {{! --- ПРАВАЯ ЧАСТЬ (USER NAVIGATION) --- }}
        <div id="usernavigation" class="navbar-nav ms-auto align-items-center gap-2">
            
            {{! ПЕРЕНЕСЕНО: Сюда вставляем ссылки, чтобы они были перед профилем }}
            {{^themestyleheader}}
                {{#primarymoremenu}}
                    <div class="primary-navigation">
                        {{> core/moremenu}}
                    </div>
                {{/primarymoremenu}}

                <ul class="navbar-nav d-none d-md-flex my-1 px-1 gap-1">
                    {{{ output.page_heading_menu }}}
                </ul>
            {{/themestyleheader}}

            {{#langmenu}}
                {{> theme_boost/language_menu }}
            {{/langmenu}}
            
            <div class="search-box-wrapper mx-2">
                {{{ output.search_box }}}
            </div>
            
            <div class="navbar-plugin-output me-2">
                {{{ output.navbar_plugin_output }}}
            </div>
            
            <div class="d-flex align-items-stretch usermenu-container" data-region="usermenu">
                {{#usermenu}}
                    {{> core/user_menu }}
                {{/usermenu}}
            </div>
            <div class="edit-switch-wrapper ms-2">
                {{{ output.edit_switch }}}
            </div>
        </div>
    </div>
</nav>
{{> theme_boost/primary-drawer-mobile }}