<nav id="header" class="{{^themestyleheader }} moodle-based-header {{/themestyleheader }} fixed-top navbar navbar-light bg-faded navbar-static-top navbar-expand-sm navbar-expand-md navbar-expand-lg moodle-has-zindex shadow-sm py-1 py-md-2" aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="container-fluid px-2">
            {{^themestyleheader}}
                <div class="d-flex align-items-center">
                    <button class="navbar-toggler aabtn d-block d-lg-none px-1 py-1 border-0 bg-transparent rounded" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-primary">
                        <span class="navbar-toggler-icon"></span>
                        <span class="sr-only">{{#str}}sidepanel, core{{/str}}</span>
                    </button>
                    <a href="{{{ config.wwwroot }}}/?redirect=0" class="navbar-brand {{# logourl }}has-logo{{/ logourl }} {{^ logourl }} hidden-sm-down {{/ logourl }} mx-0 mx-md-2 my-1 d-flex align-items-center flex-shrink-0">
                        {{#showlogo}}
                            {{# logourl }}
                                <span class="logo me-1 me-md-2">
                                    <img src="{{logourl}}" alt="{{sitename}}" class="img-fluid" style="max-height: 30px;">
                                </span>
                            {{/ logourl }}
                            {{^ logourl }}
                                <span class="site-name hidden-sm-down fw-bold" style="font-size: 0.9rem;">{{{ sitename }}}</span>
                            {{/ logourl }}
                        {{/showlogo}}
                        {{#showsitename}}
                            <span class="nav-site-name text-truncate" style="font-size: 0.9rem;">{{{sitename}}}</span>
                        {{/showsitename}}
                    </a>

                    {{#themestyleheader}}
                        <div class="nav address-head flex-wrap gap-1 gap-md-2 d-none d-lg-flex ms-2 ms-lg-3 flex-shrink-1">
                            {{# phoneno}}
                                <span class="d-flex align-items-center" style="font-size: 0.8rem;"><i class="fa fa-phone me-1"></i>{{#str}}callus, theme_academi{{/str}} : {{ phoneno }}</span>
                            {{/ phoneno}}
                            {{# emailid}}
                                <span class="d-flex align-items-center" style="font-size: 0.8rem;"><i class="fa fa-envelope-o me-1"></i>{{#str}}email, theme_academi{{/str}} : <a href="mailto:{{emailid}}" class="text-white text-decoration-none">{{ emailid }}</a></span>
                            {{/ emailid}}
                        </div>
                    {{/themestyleheader}}
                </div>
            {{/themestyleheader}}

            {{#themestyleheader}}
                <div class="d-flex align-items-center">
                    <div class="nav address-head flex-wrap gap-1 gap-md-2 d-none d-lg-flex flex-shrink-1">
                        {{# phoneno}}
                            <span class="d-flex align-items-center" style="font-size: 0.8rem;"><i class="fa fa-phone me-1"></i>{{#str}}callus, theme_academi{{/str}} : {{ phoneno }}</span>
                        {{/ phoneno}}
                        {{# emailid}}
                            <span class="d-flex align-items-center" style="font-size: 0.8rem;"><i class="fa fa-envelope-o me-1"></i>{{#str}}email, theme_academi{{/str}} : <a href="mailto:{{emailid}}" class="text-white text-decoration-none">{{ emailid }}</a></span>
                        {{/ emailid}}
                    </div>
                </div>
            {{/themestyleheader}}

        {{! --- ПРАВАЯ ЧАСТЬ (USER NAVIGATION) --- }}
        <div id="usernavigation" class="d-flex align-items-center ms-auto gap-1">

            {{! ПЕРЕНЕСЕНО: Сюда вставляем ссылки, чтобы они были перед профилем }}
            {{^themestyleheader}}
                {{#primarymoremenu}}
                    <div class="primary-navigation d-none d-xl-block flex-shrink-0">
                        {{> core/moremenu}}
                    </div>
                {{/primarymoremenu}}

                <ul class="navbar-nav d-none d-xl-flex my-0 mx-1 gap-1 flex-shrink-0">
                    {{{ output.page_heading_menu }}}
                </ul>
            {{/themestyleheader}}

            {{#langmenu}}
                <div class="d-none d-md-block flex-shrink-0">
                    {{> theme_boost/language_menu }}
                </div>
            {{/langmenu}}

            <div class="search-box-wrapper d-none d-lg-block mx-1 flex-shrink-0">
                {{{ output.search_box }}}
            </div>

            <div class="d-flex d-md-none d-lg-flex align-items-center mx-1 gap-1 flex-shrink-0">
                {{{ output.navbar_plugin_output }}}
            </div>

            <div class="d-flex align-items-center usermenu-container flex-shrink-0" data-region="usermenu">
                <div class="usermenu-content">
                    {{#usermenu}}
                        {{> core/user_menu }}
                    {{/usermenu}}
                    {{^usermenu}}
                        <!-- Placeholder for user menu when not logged in -->
                    {{/usermenu}}
                </div>
            </div>
            <div class="edit-switch-wrapper d-none d-md-block ms-1 flex-shrink-0">
                <div class="d-flex align-items-center">
                    {{{ output.edit_switch }}}
                    {{^output.edit_switch}}
                        <!-- Edit switch placeholder when not available -->
                    {{/output.edit_switch}}
                </div>
            </div>
        </div>
    </div>
</nav>
{{> theme_boost/primary-drawer-mobile }}