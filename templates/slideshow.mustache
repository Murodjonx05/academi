{{#status}}
    {{#sliderblockstatus}}
        <div class="homepage-carousel">
            {{#numofslide}}
                <a href="#" class="prevBtn carousel-control left"><span aria-hidden="true"></span></a>
                <a href="#" class="nextBtn carousel-control right"><span aria-hidden="true"></span></a>
            {{/numofslide}}

            <div id="homepage-carousel" class="custom-homeslider">
                {{#slides}}
                    {{#slidestatus}}
                        {{#slideimg}}
                            <div class="homecarousel-slide-item carousel-item">
                                <div class="slide-wrapper">
                                    <img src="{{{slideimg}}}" alt="{{caption}}" class="slide-img">
                                    <div class="slide-overlay"></div>
                                    {{#slidecontentstatus}}
                                    <div class="slide-caption">
                                        <div class="container">
                                            <div class="row">
                                                <div class="col-lg-6 col-md-8">
                                                    <div class="caption-box">
                                                        {{#caption}}
                                                            <h2 class="caption-title">{{{caption}}}</h2>
                                                        {{/caption}}
                                                        {{#desc}}
                                                            <p class="caption-desc">{{{desc}}}</p>
                                                        {{/desc}}
                                                        {{#btntxt}}
                                                            <a href="{{{btnlink}}}" target="{{btntarget}}" class="btn btn-primary">
                                                                {{btntxt}}
                                                            </a>
                                                        {{/btntxt}}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    {{/slidecontentstatus}}
                                </div>
                            </div>
                        {{/slideimg}}
                    {{/slidestatus}}
                {{/slides}}
            </div>
        </div>
    {{/sliderblockstatus}}
{{/status}}

<style>
.homepage-carousel {
    position: relative;
    width: 100%;
    overflow: hidden;
}

.slide-wrapper {
    position: relative;
    width: 100%;
    height: 600px;
    overflow: hidden;
}

.slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.slide-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.3) 100%);
}

.slide-caption {
    position: absolute;
    bottom: 80px;
    left: 0;
    width: 100%;
    z-index: 10;
}

.caption-box {
    background: rgba(255,255,255,0.95);
    padding: 2rem;
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.1);
}

.caption-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: #0f172a;
}

.caption-desc {
    font-size: 1.125rem;
    color: #475569;
    margin-bottom: 1.5rem;
}

@media (max-width: 991px) {
    .slide-wrapper { height: 500px; }
    .caption-title { font-size: 1.5rem; }
    .caption-desc { font-size: 1rem; }
    .caption-box { padding: 1.5rem; }
}

@media (max-width: 767px) {
    .slide-wrapper { height: 400px; }
    .slide-caption { bottom: 40px; }
    .caption-title { font-size: 1.25rem; }
    .caption-box { padding: 1rem; }
}
</style>